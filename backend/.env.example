# Google AI Studio key. Leave empty to run with the rule-based advisor only.
GEMINI_API_KEY=
# Optional backup key(s), comma-separated. Used automatically when the main key's quota runs out.
GEMINI_API_KEY_BACKUP=
GEMINI_MODEL=gemini-3.5-flash-lite

# Origins allowed to call the API (JSON list).
CORS_ORIGINS=["http://localhost:3000"]

# Shared secret for the staff plan import at /admin. Leave empty to disable it.
ADMIN_TOKEN=

# Upstash Redis REST credentials. Vercel's Upstash integration sets these automatically;
# leave empty locally to store plans in app/data/plans.
KV_REST_API_URL=
KV_REST_API_TOKEN=
